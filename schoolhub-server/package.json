{
  "name": "schoolhub-server",
  "version": "14.0.0-wm2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "test": "vitest run --exclude dist/** --maxWorkers=1 --fileParallelism=false",
    "test:unit": "vitest run tests/unit --exclude dist/**",
    "test:integration": "vitest run tests/integration --exclude dist/** --maxWorkers=1 --fileParallelism=false",
    "test:postgres": "tsx tests/real-postgres-smoke.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/database/migrate-cli.ts",
    "seed:authorization-qa": "node --env-file-if-exists=.env --import tsx src/scripts/seed-authorization-qa.ts",
    "verify:authorization-qa": "node --env-file-if-exists=.env --import tsx src/scripts/verify-authorization-qa.ts",
    "docs:authorization": "node --import tsx src/scripts/generate-authorization-docs.ts",
    "validate:workspaces": "node --env-file-if-exists=.env --import tsx src/scripts/validate-workspace-conformance.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "argon2": "^0.44.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/sanitize-html": "^2.16.0",
    "pg-mem": "^3.0.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "esbuild@0.28.2": true
  }
}
