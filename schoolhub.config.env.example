# SchoolHub Phase 11 unified configuration
# Copy this file to schoolhub.config.env and replace every CHANGE_ME value.
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080
API_HOST=127.0.0.1
API_PORT=4010
START_API=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=schoolhub
POSTGRES_USER=schoolhub_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SSLMODE=disable
SCHOOL_SLUG=
NODE_ENV=development
SESSION_COOKIE_NAME=schoolhub_sid
SESSION_TTL_MINUTES=480
ALLOWED_ORIGINS=AUTO
TRUST_PROXY=false
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_MAX_SIZE_MB=20
LOG_RETENTION_DAYS=30
PORTAL_ROLLOUT_MODE=ReadOnly
# Universal Workspace Runtime rollout: which operational workspaces use the universal frontend.
# Comma-separated workspace keys, * for all, or empty for none (legacy screens everywhere).
# Custom workspaces always use the universal runtime. Permissions are never affected by this setting.
UNIVERSAL_RUNTIME_WORKSPACES=students,uniform
