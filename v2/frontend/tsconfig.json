{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUnusedLocals": true, "skipLibCheck": true, "noEmit": true, "allowImportingTsExtensions": false,
    "baseUrl": ".", "paths": { "@shared/*": ["../shared/src/*"] }, "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts", "../shared/src"]
}
