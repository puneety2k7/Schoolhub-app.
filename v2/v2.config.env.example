# SchoolHub V2 private configuration.
# Copy this file to  v2.config.env  (same folder), fill in the two CHANGE_ME values, and never share or commit v2.config.env.
# V2 uses its OWN PostgreSQL database. It refuses to start against any other database (including your old SchoolHub one).

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=schoolhub_v2
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Optional: a second throw-away database used ONLY by automated tests (wiped on every run). Leave empty to skip those tests.
POSTGRES_TEST_DATABASE=schoolhub_v2_test

# V2 ports (different from the old SchoolHub ports 4010 and 8080).
SERVER_HOST=127.0.0.1
SERVER_PORT=4120
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5180
