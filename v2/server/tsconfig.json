{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext", "strict": true, "noUncheckedIndexedAccess": false,
    "esModuleInterop": true, "skipLibCheck": true, "outDir": "dist", "rootDir": "..", "declaration": false, "sourceMap": true,
    "forceConsistentCasingInFileNames": true, "noUnusedLocals": true, "noImplicitOverride": true
  },
  "include": ["src", "../shared/src", "tests"]
}
